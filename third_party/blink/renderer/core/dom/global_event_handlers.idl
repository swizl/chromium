// https://html.spec.whatwg.org/C/#globaleventhandlers
interface mixin GlobalEventHandlers {
  attribute EventHandler onabort;
  [ImplementedAs=onabort] attribute EventHandler 中止时;
  [RuntimeEnabled=FilteringPrimitives] attribute EventHandler onbeforefilter;
  attribute EventHandler onbeforeinput;
  [ImplementedAs=onbeforeinput] attribute EventHandler 输入前时;
  attribute EventHandler onbeforematch;
  [ImplementedAs=onbeforematch] attribute EventHandler 匹配前时;
  attribute EventHandler onbeforetoggle;
  [ImplementedAs=onbeforetoggle] attribute EventHandler 切换前时;
  attribute EventHandler onblur;
  [ImplementedAs=onblur] attribute EventHandler 失去焦点时;
  attribute EventHandler oncancel;
  [ImplementedAs=oncancel] attribute EventHandler 取消时;
  attribute EventHandler oncanplay;
  [ImplementedAs=oncanplay] attribute EventHandler 可播放时;
  attribute EventHandler oncanplaythrough;
  [ImplementedAs=oncanplaythrough] attribute EventHandler 可流畅播放时;
  attribute EventHandler onchange;
  [ImplementedAs=onchange] attribute EventHandler 改变时;
  attribute EventHandler onclick;
  [ImplementedAs=onclick] attribute EventHandler 点击时;
  attribute EventHandler onclose;
  [ImplementedAs=onclose] attribute EventHandler 关闭时;
  attribute EventHandler oncommand;
  [RuntimeEnabled=LoginElement] attribute EventHandler oncomplete;
  attribute EventHandler oncontentvisibilityautostatechange;
  [ImplementedAs=oncontentvisibilityautostatechange] attribute EventHandler 内容可见性自动状态变化时;
  attribute EventHandler oncontextlost;
  [ImplementedAs=oncontextlost] attribute EventHandler 上下文丢失时;
  attribute EventHandler oncontextmenu;
  [ImplementedAs=oncontextmenu] attribute EventHandler 上下文菜单;
  attribute EventHandler oncontextrestored;
  [ImplementedAs=oncontextrestored] attribute EventHandler 上下文恢复时;
  attribute EventHandler oncuechange;
  [ImplementedAs=oncuechange] attribute EventHandler 提示变化时;
  attribute EventHandler ondblclick;
  [ImplementedAs=ondblclick] attribute EventHandler 双击时;
  attribute EventHandler ondrag;
  [ImplementedAs=ondrag] attribute EventHandler 拖动时;
  attribute EventHandler ondragend;
  [ImplementedAs=ondragend] attribute EventHandler 拖动结束时;
  attribute EventHandler ondragenter;
  [ImplementedAs=ondragenter] attribute EventHandler 拖入时;
  //attribute EventHandler ondragexit;
  attribute EventHandler ondragleave;
  [ImplementedAs=ondragleave] attribute EventHandler 拖出时;
  attribute EventHandler ondragover;
  [ImplementedAs=ondragover] attribute EventHandler 拖动经过时;
  attribute EventHandler ondragstart;
  [ImplementedAs=ondragstart] attribute EventHandler 拖动开始时;
  attribute EventHandler ondrop;
  [ImplementedAs=ondrop] attribute EventHandler 放置时;
  attribute EventHandler ondurationchange;
  [ImplementedAs=ondurationchange] attribute EventHandler 时长变化时;
  attribute EventHandler onemptied;
  [ImplementedAs=onemptied] attribute EventHandler 清空时;
  attribute EventHandler onended;
  attribute OnErrorEventHandler onerror;
  [ImplementedAs=onerror] attribute OnErrorEventHandler 出错时;
  attribute EventHandler onfocus;
  [ImplementedAs=onfocus] attribute EventHandler 获得焦点时;
  attribute EventHandler onformdata;
  [ImplementedAs=onformdata] attribute EventHandler 表单数据时;
  attribute EventHandler oninput;
  [ImplementedAs=oninput] attribute EventHandler 输入时;
  attribute EventHandler oninvalid;
  [ImplementedAs=oninvalid] attribute EventHandler 无效时;
  attribute EventHandler onkeydown;
  [ImplementedAs=onkeydown] attribute EventHandler 键盘按下时;
  attribute EventHandler onkeypress;
  [ImplementedAs=onkeypress] attribute EventHandler 键盘按键时;
  attribute EventHandler onkeyup;
  [ImplementedAs=onkeyup] attribute EventHandler 键盘释放时;
  attribute EventHandler onload;
  [ImplementedAs=onload] attribute EventHandler 加载时;
  attribute EventHandler onloadeddata;
  [ImplementedAs=onloadeddata] attribute EventHandler 数据已加载时;
  attribute EventHandler onloadedmetadata;
  [ImplementedAs=onloadedmetadata] attribute EventHandler 元数据已加载时;
  attribute EventHandler onloadstart;
  [ImplementedAs=onloadstart] attribute EventHandler 开始加载时;
  attribute EventHandler onmousedown;
  [ImplementedAs=onmousedown] attribute EventHandler 鼠标按下时;
  [LegacyLenientThis] attribute EventHandler onmouseenter;
  [LegacyLenientThis] attribute EventHandler onmouseleave;
  attribute EventHandler onmousemove;
  [ImplementedAs=onmousemove] attribute EventHandler 鼠标移动时;
  attribute EventHandler onmouseout;
  [ImplementedAs=onmouseout] attribute EventHandler 鼠标离开时;
  attribute EventHandler onmouseover;
  [ImplementedAs=onmouseover] attribute EventHandler 鼠标进入时;
  attribute EventHandler onmouseup;
  [ImplementedAs=onmouseup] attribute EventHandler 鼠标释放时;
  attribute EventHandler onmousewheel;
  [RuntimeEnabled=OverscrollAreas] attribute EventHandler onoverscrollcancel;
  [RuntimeEnabled=OverscrollAreas] attribute EventHandler onoverscrollchanging;
  [RuntimeEnabled=OverscrollAreas] attribute EventHandler onoverscrollend;
  [RuntimeEnabled=OverscrollAreas] attribute EventHandler onoverscrollstart;
  attribute EventHandler onpause;
  [ImplementedAs=onpause] attribute EventHandler 暂停时;
  attribute EventHandler onplay;
  attribute EventHandler onplaying;
  [ImplementedAs=onplaying] attribute EventHandler 播放中时;
  attribute EventHandler onprogress;
  attribute EventHandler onratechange;
  [ImplementedAs=onratechange] attribute EventHandler 播放速率改变时;
  attribute EventHandler onreset;
  [ImplementedAs=onreset] attribute EventHandler 重置时;
  attribute EventHandler onresize;
  [ImplementedAs=onresize] attribute EventHandler 调整大小时;
  attribute EventHandler onscroll;
  [ImplementedAs=onscroll] attribute EventHandler 滚动时;
  attribute EventHandler onscrollend;
  attribute EventHandler onsecuritypolicyviolation;
  [ImplementedAs=onsecuritypolicyviolation] attribute EventHandler 安全策略违规时;
  attribute EventHandler onseeked;
  [ImplementedAs=onseeked] attribute EventHandler 定位后时;
  attribute EventHandler onseeking;
  [ImplementedAs=onseeking] attribute EventHandler 定位中时;
  attribute EventHandler onselect;
  [ImplementedAs=onselect] attribute EventHandler 选择时;
  attribute EventHandler onslotchange;
  [ImplementedAs=onslotchange] attribute EventHandler 插槽变化时;
  [RuntimeEnabled=CSSScrollSnapChangeEvent] attribute EventHandler onscrollsnapchange;
  [RuntimeEnabled=CSSScrollSnapChangingEvent] attribute EventHandler onscrollsnapchanging;
  //attribute EventHandler onsort;
  attribute EventHandler onstalled;
  [ImplementedAs=onstalled] attribute EventHandler 停滞时;
  attribute EventHandler onsubmit;
  [ImplementedAs=onsubmit] attribute EventHandler 提交时;
  attribute EventHandler onsuspend;
  [ImplementedAs=onsuspend] attribute EventHandler 挂起时;
  attribute EventHandler ontimeupdate;
  [ImplementedAs=ontimeupdate] attribute EventHandler 时间更新时;
  attribute EventHandler ontoggle;
  [ImplementedAs=ontoggle] attribute EventHandler 切换时;
  attribute EventHandler onvolumechange;
  [ImplementedAs=onvolumechange] attribute EventHandler 音量改变时;
  attribute EventHandler onwaiting;
  [ImplementedAs=onwaiting] attribute EventHandler 等待时;
  attribute EventHandler onwebkitanimationend;
  attribute EventHandler onwebkitanimationiteration;
  attribute EventHandler onwebkitanimationstart;
  attribute EventHandler onwebkittransitionend;
  attribute EventHandler onwheel;
  [ImplementedAs=onwheel] attribute EventHandler 滚轮时;

  // auxclick
  // https://wicg.github.io/auxclick/
  attribute EventHandler onauxclick;
  [ImplementedAs=onauxclick] attribute EventHandler 辅助点击时;

  // Pointer Events
  // https://w3c.github.io/pointerevents/#extensions-to-the-globaleventhandlers-interface
  attribute EventHandler ongotpointercapture;
  [ImplementedAs=ongotpointercapture] attribute EventHandler 获得指针捕获时;
  attribute EventHandler onlostpointercapture;
  [ImplementedAs=onlostpointercapture] attribute EventHandler 失去指针捕获时;
  attribute EventHandler onpointerdown;
  [ImplementedAs=onpointerdown] attribute EventHandler 指针按下时;
  attribute EventHandler onpointermove;
  [ImplementedAs=onpointermove] attribute EventHandler 指针移动时;
  [SecureContext] attribute EventHandler onpointerrawupdate;
  [ImplementedAs=onpointerrawupdate] attribute EventHandler 指针原始更新时;
  attribute EventHandler onpointerup;
  [ImplementedAs=onpointerup] attribute EventHandler 指针释放时;
  attribute EventHandler onpointercancel;
  [ImplementedAs=onpointercancel] attribute EventHandler 指针取消时;
  attribute EventHandler onpointerover;
  [ImplementedAs=onpointerover] attribute EventHandler 指针进入时;
  attribute EventHandler onpointerout;
  [ImplementedAs=onpointerout] attribute EventHandler 指针离开时;
  attribute EventHandler onpointerenter;
  [ImplementedAs=onpointerenter] attribute EventHandler 指针进入元素时;
  attribute EventHandler onpointerleave;
  [ImplementedAs=onpointerleave] attribute EventHandler 指针离开元素时;

  // Touch Events
  // https://w3c.github.io/touch-events/#extensions-to-the-globaleventhandlers-interface
  [RuntimeEnabled=TouchEventFeatureDetection] attribute EventHandler ontouchcancel;
  [RuntimeEnabled=TouchEventFeatureDetection] attribute EventHandler ontouchend;
  [RuntimeEnabled=TouchEventFeatureDetection] attribute EventHandler ontouchmove;
  [RuntimeEnabled=TouchEventFeatureDetection] attribute EventHandler ontouchstart;

  // Selection API
  // https://w3c.github.io/selection-api/#extensions-to-globaleventhandlers
  attribute EventHandler onselectstart;
  attribute EventHandler onselectionchange;

  // CSS Animations
  // https://drafts.csswg.org/css-animations/#interface-globaleventhandlers-idl
  attribute EventHandler onanimationcancel;
  attribute EventHandler onanimationend;
  [ImplementedAs=onanimationend] attribute EventHandler 动画结束时;
  attribute EventHandler onanimationiteration;
  [ImplementedAs=onanimationiteration] attribute EventHandler 动画迭代时;
  attribute EventHandler onanimationstart;
  [ImplementedAs=onanimationstart] attribute EventHandler 动画开始时;

  // CSS Transitions
  // https://drafts.csswg.org/css-transitions/#interface-globaleventhandlers-idl
  attribute EventHandler ontransitionrun;
  [ImplementedAs=ontransitionrun] attribute EventHandler 过渡运行时;
  attribute EventHandler ontransitionstart;
  [ImplementedAs=ontransitionstart] attribute EventHandler 过渡开始时;
  attribute EventHandler ontransitionend;
  [ImplementedAs=ontransitionend] attribute EventHandler 过渡结束时;
  attribute EventHandler ontransitioncancel;
  [ImplementedAs=ontransitioncancel] attribute EventHandler 过渡取消时;
};
