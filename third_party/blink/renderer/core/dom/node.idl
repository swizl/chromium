// https://dom.spec.whatwg.org/#interface-node

[
    Exposed=Window
] interface Node : EventTarget {
    const unsigned short ELEMENT_NODE = 1;
    const unsigned short ATTRIBUTE_NODE = 2;
    const unsigned short TEXT_NODE = 3;
    const unsigned short CDATA_SECTION_NODE = 4;
    const unsigned short ENTITY_REFERENCE_NODE = 5; // historical
    const unsigned short ENTITY_NODE = 6; // historical
    const unsigned short PROCESSING_INSTRUCTION_NODE = 7;
    const unsigned short COMMENT_NODE = 8;
    const unsigned short DOCUMENT_NODE = 9;
    const unsigned short DOCUMENT_TYPE_NODE = 10;
    const unsigned short DOCUMENT_FRAGMENT_NODE = 11;
    const unsigned short NOTATION_NODE = 12; // historical
    [ImplementedAs=getNodeType] readonly attribute unsigned short nodeType;
    [ImplementedAs=getNodeType] readonly attribute unsigned short 节点类型;
    [RuntimeCallStatsCounter=NodeName] readonly attribute DOMString nodeName;
    [RuntimeCallStatsCounter=NodeName, ImplementedAs=nodeName] readonly attribute DOMString 节点名;

    readonly attribute USVString baseURI;
    [ImplementedAs=baseURI] readonly attribute USVString 基本URI;

    [Measure] readonly attribute boolean isConnected;
    [ImplementedAs=isConnected] readonly attribute boolean 已连接;
    [PerWorldBindings] readonly attribute Document? ownerDocument;
    [PerWorldBindings, ImplementedAs=ownerDocument] readonly attribute Document? 所属文档;
    [PerWorldBindings] readonly attribute Node? parentNode;
    [PerWorldBindings, ImplementedAs=parentNode] readonly attribute Node? 父节点;
    [PerWorldBindings] readonly attribute Element? parentElement;
    [PerWorldBindings, ImplementedAs=parentElement] readonly attribute Element? 父元素;
    [Affects=Nothing, ImplementedAs=hasChildren] boolean hasChildNodes();
    [Affects=Nothing, ImplementedAs=hasChildren] boolean 有子节点();
    [SameObject, PerWorldBindings] readonly attribute NodeList childNodes;
    [SameObject, PerWorldBindings, ImplementedAs=childNodes] readonly attribute NodeList 子节点;
    [PerWorldBindings] readonly attribute Node? firstChild;
    [PerWorldBindings, ImplementedAs=firstChild] readonly attribute Node? 首个子节点;
    [PerWorldBindings] readonly attribute Node? lastChild;
    [PerWorldBindings, ImplementedAs=lastChild] readonly attribute Node? 末个子节点;
    [PerWorldBindings] readonly attribute Node? previousSibling;
    [PerWorldBindings, ImplementedAs=previousSibling] readonly attribute Node? 前一个兄弟;
    [PerWorldBindings] readonly attribute Node? nextSibling;
    [PerWorldBindings, ImplementedAs=nextSibling] readonly attribute Node? 后一个兄弟;
    [MeasureAs=NodeGetRootNode] Node getRootNode(optional GetRootNodeOptions options = {});
    [MeasureAs=NodeGetRootNode, ImplementedAs=getRootNode] Node 获取根节点(optional GetRootNodeOptions options = {});

    [CEReactions, RaisesException=Setter] attribute DOMString? nodeValue;
    [CEReactions, RaisesException=Setter, ImplementedAs=nodeValue] attribute DOMString? 节点值;

    [CEReactions, ImplementedAs=textContentForBinding, RaisesException=Setter] attribute (DOMString or TrustedScript)? textContent;
    [CEReactions, ImplementedAs=textContentForBinding, RaisesException=Setter] attribute (DOMString or TrustedScript)? 文本内容;
    [CEReactions] undefined normalize();
    [CEReactions, ImplementedAs=normalize] undefined 规范化();

    [NewObject, CEReactions, RaisesException] Node cloneNode(optional boolean deep = false);
    [NewObject, CEReactions, RaisesException, ImplementedAs=cloneNode] Node 克隆节点(optional boolean deep = false);
    boolean isEqualNode(Node? otherNode);
    [ImplementedAs=isEqualNode] boolean 相等节点(Node? otherNode);
    boolean isSameNode(Node? otherNode); // historical alias of ===
    [ImplementedAs=isSameNode] boolean 相同节点(Node? otherNode);

    const unsigned short DOCUMENT_POSITION_DISCONNECTED = 0x01;
    const unsigned short DOCUMENT_POSITION_PRECEDING = 0x02;
    const unsigned short DOCUMENT_POSITION_FOLLOWING = 0x04;
    const unsigned short DOCUMENT_POSITION_CONTAINS = 0x08;
    const unsigned short DOCUMENT_POSITION_CONTAINED_BY = 0x10;
    const unsigned short DOCUMENT_POSITION_IMPLEMENTATION_SPECIFIC = 0x20;
    unsigned short compareDocumentPosition(Node other);
    [ImplementedAs=compareDocumentPosition] unsigned short 比较文档位置(Node other);
    [Affects=Nothing] boolean contains(Node? other);
    [Affects=Nothing, ImplementedAs=contains] boolean 包含(Node? other);

    DOMString? lookupPrefix(DOMString? namespaceURI);
    [ImplementedAs=lookupPrefix] DOMString? 查找前缀(DOMString? namespaceURI);
    DOMString? lookupNamespaceURI(DOMString? prefix);
    [ImplementedAs=lookupNamespaceURI] DOMString? 查找命名空间URI(DOMString? prefix);
    boolean isDefaultNamespace(DOMString? namespaceURI);
    [ImplementedAs=isDefaultNamespace] boolean 默认命名空间(DOMString? namespaceURI);

    [CEReactions, PerWorldBindings, RaisesException] Node insertBefore(Node node, Node? child);
    [CEReactions, PerWorldBindings, RaisesException, ImplementedAs=insertBefore] Node 插入前(Node node, Node? child);
    [CEReactions, PerWorldBindings, RaisesException, RuntimeCallStatsCounter=NodeAppendChild] Node appendChild(Node node);
    [CEReactions, PerWorldBindings, RaisesException, RuntimeCallStatsCounter=NodeAppendChild, ImplementedAs=appendChild] Node 追加子节点(Node node);
    [CEReactions, PerWorldBindings, RaisesException] Node replaceChild(Node node, Node child);
    [CEReactions, PerWorldBindings, RaisesException, ImplementedAs=replaceChild] Node 替换子节点(Node node, Node child);
    [CEReactions, RaisesException, RuntimeCallStatsCounter=NodeRemoveChild] Node removeChild(Node child);
    [CEReactions, RaisesException, RuntimeCallStatsCounter=NodeRemoveChild, ImplementedAs=removeChild] Node 移除子节点(Node child);
};
